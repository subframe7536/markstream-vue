{
  "name": "markstream-solid",
  "type": "module",
  "version": "0.0.1-beta.1",
  "description": "Experimental SolidJS Markdown renderer for Markstream, aligned with the Vue, React, Angular, and Svelte packages.",
  "author": "Simon He",
  "license": "MIT",
  "homepage": "https://github.com/Simon-He95/markstream-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simon-He95/markstream-vue.git",
    "directory": "packages/markstream-solid"
  },
  "bugs": {
    "url": "https://github.com/Simon-He95/markstream-vue/issues"
  },
  "keywords": [
    "solid",
    "solidjs",
    "markdown",
    "markdown-renderer",
    "streaming-markdown",
    "markstream",
    "markstream-solid"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./index.px.css": "./dist/index.px.css",
    "./index.tailwind.css": "./dist/index.tailwind.css",
    "./tailwind": "./dist/tailwind.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm --dir ../markstream-core build && vite build --mode npm && vite build -c vite.config.tailwind.ts --mode npm && node ./scripts/copy-tailwind-css.mjs && node ../../scripts/generate-px-css.mjs && pnpm run build:dts",
    "build:analyze": "ANALYZE=true pnpm build",
    "build:dts": "rollup -c ./scripts/rollup.dts.config.mjs && node ./scripts/clean-dts.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "size:check": "node ../../scripts/check-package-size.mjs",
    "check:core-published": "node ../../scripts/check-core-published.mjs --package-json package.json --core-package-json ../markstream-core/package.json",
    "release": "pnpm run check:core-published && bumpp --commit --no-tag --no-push && pnpm publish --access public && node ../../scripts/tag-package.mjs --package-json package.json --push"
  },
  "peerDependencies": {
    "solid-js": ">=1.9"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "markstream-core": "workspace:*",
    "stream-markdown-parser": "workspace:*"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^5.3.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "solid-js": "^1.9.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.12"
  }
}
